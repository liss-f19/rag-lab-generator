# Copy to .env and fill in the secrets. .env is ignored by git and Docker.

# Signing key for bearer tokens, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SIGNING_KEY=

# Password of the PostgreSQL service in docker-compose.yml.
POSTGRES_PASSWORD=

# Embeddings: "openai" (needs OPENAI_API_KEY) or "hashing" (offline,
# deterministic bag-of-words vectors for tests and demos; not semantic).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Ingestion
# MAX_UPLOAD_BYTES=20971520
# CHUNK_MAX_CHARS=1200
# CHUNK_OVERLAP_CHARS=150

# Local development without Docker; docker-compose.yml sets these itself.
# DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag_lab
# REDIS_URL=redis://localhost:6379/0
# QUEUE_BACKEND=rq
# "inline" runs jobs inside the API process: no Redis and no worker needed.
# FILE_STORAGE_DIR=./data/files
# CHROMA_PERSIST_DIRECTORY=./data/chroma
